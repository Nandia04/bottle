void setPixelColorRGB(uint8_t r, uint8_t g, uint8_t b) {
  pixel.setBrightness(NEOPIXEL_BRIGHTNESS);

  for (int i = 0; i < NEOPIXEL_COUNT; i++) {
    pixel.setPixelColor(i, pixel.Color(r, g, b));
  }

  pixel.show();
}

void clearPixel() {
  pixel.clear();
  pixel.show();
}

void buzzerOff() {
  ledcWriteTone(buzzerPin, 0);
}

void beepOnce(int freq = 2000, int durationMs = 150) {
  ledcWriteTone(buzzerPin, freq);
  delay(durationMs);
  buzzerOff();
}

void flashLED(uint8_t r, uint8_t g, uint8_t b, int times, int onMs, int offMs, bool useBuzzer) {
  for (int i = 0; i < times; i++) {
    setPixelColorRGB(r, g, b);

    if (useBuzzer) {
      ledcWriteTone(buzzerPin, 2000);
    }

    delay(onMs);

    clearPixel();
    buzzerOff();

    delay(offMs);
  }
}

