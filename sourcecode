// =====================================================
// BATTERY
// =====================================================
float readBatteryVoltage() {
#if BATTERY_MONITOR_ENABLED
  int raw = analogRead(BATTERY_ADC_PIN);
  float adcVoltage = (raw / 4095.0) * 3.3;
  float batteryVoltage = adcVoltage * VOLTAGE_DIVIDER_RATIO;
  return batteryVoltage;
#else
  return 4.0;
#endif
}

void checkBatteryLow() {
#if BATTERY_MONITOR_ENABLED
  float voltage = readBatteryVoltage();

  if (voltage <= batteryLowVoltage) {
    batteryLowActive = true;
  } else {
    batteryLowActive = false;
  }

  if (batteryLowActive && millis() - lastBatteryAlertTime >= batteryAlertInterval) {
    Serial.print("LOW BATTERY: ");
    Serial.println(voltage);
    batteryLowAlert();
    lastBatteryAlertTime = millis();
  }
#endif
}

