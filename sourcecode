// =====================================================
// REMINDER
// =====================================================
void activateReminder(DateTime now) {
  if (!reminderEnabled) return;

  reminderActive = true;
  drankConfirmed = false;
  reminderCount++;
  waterStatus = "Сануулах цаг болсон";

  updateNextReminderTime(now);

  Serial.println("TIME TO DRINK!");
  printNextReminderToSerial();

  reminderAlert();

  saveEvent(now, "reminder");
  saveTodayCounters();
  sendToBlynkIfChanged(true);

  lastRepeatAlertTime = millis();
}

// =====================================================
// DRINK
// =====================================================
void confirmDrink(DateTime now, float drank) {
  lastDrink = drank;
  totalDrink += drank;
  completedDrinks++;
  waterStatus = "Ус уусан";

  reminderActive = false;
  drankConfirmed = true;
  drinkLedStartTime = millis();
  lastReminderTime = millis();
  lastRepeatAlertTime = millis();

  updateNextReminderTime(now);

  Serial.print("Drank: ");
  Serial.print(drank, 1);
  Serial.println(" g");

  printNextReminderToSerial();

  drinkConfirmedLed();

  saveEvent(now, "drink");
  saveTodayCounters();
  sendToBlynkIfChanged(true);

  if (totalDrink >= dailyGoal && !dailyGoalNotified) {
    dailyGoalNotified = true;
    waterStatus = "Өдрийн зорилго биелсэн";
    goalCompletedLed();
    saveEvent(now, "goal_completed");
    sendToBlynkIfChanged(true);
  }
}

// =====================================================
// BOOT WEIGHT LOGIC
// =====================================================
void handleBootStableWeight(float bootWeight) {
  if (bootWeight < liftThreshold) {
    previousWeight = 0.0;
    saveLastStableWeight(0.0);

    Serial.println("Boot: bottle not detected or empty.");
    return;
  }

  if (previousWeight <= 0.0) {
    previousWeight = bootWeight;
    saveLastStableWeight(previousWeight);

    Serial.print("Boot: first stable weight saved: ");
    Serial.print(previousWeight, 1);
    Serial.println(" g");
    return;
  }

  float diff = bootWeight - previousWeight;

  Serial.print("Boot current weight: ");
  Serial.print(bootWeight, 1);
  Serial.println(" g");

  Serial.print("Boot saved weight: ");
  Serial.print(previousWeight, 1);
  Serial.println(" g");

  Serial.print("Boot difference: ");
  Serial.print(diff, 1);
  Serial.println(" g");

  previousWeight = bootWeight;
  saveLastStableWeight(previousWeight);

  if (fabs(diff) <= bootWeightDifferenceThreshold) {
    Serial.println("Boot: same weight, continue.");
  } else if (diff > bootWeightDifferenceThreshold) {
    Serial.println("Boot: water added while off, reference updated.");
  } else {
    Serial.println("Boot: water reduced while off, reference updated without counting drink.");
  }
}

// =====================================================
// SETUP
// =====================================================
void setup() {
  Serial.begin(115200);
  Wire.begin(21, 22);

  prefs.begin("bottle", false);

  loadUserSettings();

  initSDCard();

  if (!rtc.begin()) {
    Serial.println("RTC NOT FOUND");
  }

  loadTodayCounters();

  display.begin();

  pixel.begin();
  pixel.setBrightness(NEOPIXEL_BRIGHTNESS);
  clearPixel();

  pinMode(buzzerPin, OUTPUT);
  ledcAttach(buzzerPin, 2000, buzzerResolution);
  buzzerOff();

#if BATTERY_MONITOR_ENABLED
  analogReadResolution(12);
  pinMode(BATTERY_ADC_PIN, INPUT);
#endif

  startupLed();

  // ================= HX711 INIT =================
  LoadCell.begin();

#if FACTORY_TARE_MODE
  Serial.println("FACTORY TARE MODE ENABLED");
  Serial.println("Put EMPTY bottle on load cell.");
  Serial.println("Taring...");

  LoadCell.start(3000, true);
  LoadCell.setCalFactor(calibrationValue);

  savedTareOffset = LoadCell.getTareOffset();
  saveTareOffset(savedTareOffset);

  tareOffsetReady = true;

  Serial.println("TARE OFFSET SAVED.");
  Serial.println("Now set FACTORY_TARE_MODE to 0 and upload again.");

#else
  savedTareOffset = loadTareOffset();

  if (savedTareOffset == 0) {
    Serial.println("WARNING: No saved tare offset found!");
    Serial.println("Run once with FACTORY_TARE_MODE 1 using EMPTY bottle.");
    tareOffsetReady = false;
  } else {
    tareOffsetReady = true;
  }

  LoadCell.start(3000, false);

  if (tareOffsetReady) {
    LoadCell.setTareOffset(savedTareOffset);
    Serial.println("Saved tare offset applied.");
  }

  LoadCell.setCalFactor(calibrationValue);

  previousWeight = loadLastStableWeight();
#endif

  DateTime now = rtc.now();
  systemStartTimeStr = twoDigit(now.hour()) + ":" + twoDigit(now.minute());

  updateNextReminderTime(now);

  lastReminderTime = millis();
  lastRepeatAlertTime = millis();
  lastSyncAttempt = millis();
  lastMotionTime = millis();

  saveEvent(now, "system_start");
  waterStatus = "Систем эхэлсэн";

  Serial.println("SYSTEM STARTED - OFFLINE MODE");
  printNextReminderToSerial();

#if !FACTORY_TARE_MODE
  // Эхлэх үед Wi-Fi/Blynk холболтыг богино хугацаанд л оролдоно.
  // Холбогдохгүй байсан ч систем шууд offline горимоор жин хэмжиж эхэлнэ.
  connectWifi();
  connectBlynk();
  sendToBlynkIfChanged(true);
#endif
}

// =====================================================
// LOOP
// =====================================================
void loop() {
  DateTime now = rtc.now();

  checkNewDay(now);

  checkBatteryLow();

#if FACTORY_TARE_MODE
  if (LoadCell.update()) {
    float w = LoadCell.getData();

    display.firstPage();

    do {
      display.setFont(u8g2_font_6x10_tf);
      display.setCursor(0, 15);
      display.print("FACTORY TARE MODE");

      display.setCursor(0, 30);
      display.print("Offset saved.");

      display.setCursor(0, 45);
      display.print("Weight: ");
      display.print(w, 1);
      display.print(" g");

    } while (display.nextPage());

    Serial.print("Weight: ");
    Serial.println(w, 1);
  }

  delay(500);
  return;
#endif

  if (reminderEnabled && !reminderActive && millis() - lastReminderTime >= reminderInterval) {
    activateReminder(now);
  }

  if (reminderEnabled && reminderActive && millis() - lastRepeatAlertTime >= repeatAlertInterval) {
    Serial.println("Repeat alert: Drink water!");

    reminderAlert();

    reminderCount++;
    waterStatus = "Дахин сануулсан";

    saveEvent(now, "repeat_reminder");
    saveTodayCounters();
    sendToBlynkIfChanged(true);

    lastRepeatAlertTime = millis();
  }

  if (drankConfirmed && millis() - drinkLedStartTime >= drinkShowTime) {
    drankConfirmed = false;
    waterStatus = "Хэвийн";
    clearPixel();
    sendToBlynkIfChanged(true);
  }

  if (LoadCell.update()) {
    float w = LoadCell.getData();

    if (w < 5) {
      w = 0;
    }

    currentWeight = w;

    // =================================================
    // MOTION FILTER
    // =================================================
    if (fabs(w - lastRawWeight) > motionThreshold) {
      lastMotionTime = millis();
    }

    lastRawWeight = w;

    bool motionQuiet = (millis() - lastMotionTime >= motionQuietTime);

    // Сав жин дээр байхгүй үед төлөв reset хийнэ.
    // previousWeight-г шууд 0 болгохгүй.
    if (w < liftThreshold) {
      bottleOnScale = false;
      waitingStable = false;
    }

    // Сав жин дээр анх тавигдсан үед.
    if (w >= liftThreshold && !bottleOnScale) {
      bottleOnScale = true;
      waitingStable = true;
      stableTimer = millis();
      stableReference = w;

      Serial.println("Bottle detected, waiting for stable weight...");
    }

    // Сав жин дээрээ байгаа үед жин өөрчлөгдвөл шалгана.
    // Гэхдээ хөдөлгөөн намдаагүй бол шууд уусан гэж тооцохгүй.
    if (bottleOnScale && !waitingStable && previousWeight > 0 && motionQuiet) {
      float diff = previousWeight - w;

      // Зөвхөн жин багассан үед боломжит уусан ус гэж үзээд stable шалгалт эхлүүлнэ.
      if (diff > drinkThreshold && diff < maxDrinkThreshold) {
        waitingStable = true;
        stableTimer = millis();
        stableReference = w;

        Serial.println("Possible drink detected. Waiting for stable weight...");
      }

      // Жин нэмэгдсэн үед ус нэмсэн гэж үзэж stable update хийнэ.
      if (diff < -drinkThreshold) {
        waitingStable = true;
        stableTimer = millis();
        stableReference = w;

        Serial.println("Weight increased. Waiting for stable update...");
      }
    }

    if (waitingStable) {
      // Жин stableReference-ээс их савлаж байвал тогтворжих хугацааг дахин эхлүүлнэ.
      if (fabs(w - stableReference) > stabilityThreshold) {
        stableReference = w;
        stableTimer = millis();
      }

      // Жин хангалттай хугацаанд тогтвортой болсон эсэх.
      if (millis() - stableTimer >= stableDelay) {
        waitingStable = false;

        // Boot-ийн эхний stable жинг уусан ус гэж тооцохгүй.
        if (!bootWeightChecked) {
          bootWeightChecked = true;
          handleBootStableWeight(stableReference);
        } else {
          if (previousWeight == 0) {
            previousWeight = stableReference;
            saveLastStableWeight(previousWeight);

            Serial.print("Initial stable weight: ");
            Serial.print(previousWeight, 1);
            Serial.println(" g");
          } else {
            float drank = previousWeight - stableReference;

            // Motion намдаагүй бол уусан ус гэж тооцохгүй.
            if (motionQuiet && drank > drinkThreshold && drank < maxDrinkThreshold) {
              confirmDrink(now, drank);
            } else {
              Serial.println("Ignored unstable or invalid weight change.");
            }

            previousWeight = stableReference;
            saveLastStableWeight(previousWeight);

            Serial.print("Stable weight updated: ");
            Serial.print(previousWeight, 1);
            Serial.println(" g");
          }
        }
      }
    }

    drawDisplay(now);
  }

  // Wi-Fi/Blynk ажиллагаа хамгийн сүүлд хийгдэнэ.
  // Холболтгүй байсан ч дээрх жин хэмжилт, сануулга, SD хадгалалт ажилласан хэвээр байна.
  tryAutoSync();

  delay(50);
}
