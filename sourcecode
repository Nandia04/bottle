void calculateDailyGoal() {
  if (userWeightKg < 30.0) userWeightKg = 30.0;
  if (userWeightKg > 150.0) userWeightKg = 150.0;

  dailyGoal = userWeightKg * waterMlPerKg;
}

float calculateSuccessRate() {
  if (dailyGoal <= 0.0) return 0.0;

  float rate = (totalDrink / dailyGoal) * 100.0;

  if (rate < 0.0) rate = 0.0;
  if (rate > 100.0) rate = 100.0;

  return rate;
}

