void updateNextReminderTime(DateTime now) {
  int intervalMin = reminderInterval / 60000UL;

  int totalMin = now.hour() * 60 + now.minute() + intervalMin;
  totalMin = totalMin % (24 * 60);

  nextReminderHour = totalMin / 60;
  nextReminderMinute = totalMin % 60;
}

