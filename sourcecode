void initSDCard() {
  pinMode(SD_CS, OUTPUT);
  digitalWrite(SD_CS, HIGH);

  sdSPI.begin(SD_SCK, SD_MISO, SD_MOSI, SD_CS);

  if (!SD.begin(SD_CS, sdSPI, 400000)) {
    Serial.println("SD init FAILED");
    sdReady = false;
    return;
  }

  sdReady = true;
  Serial.println("SD init OK");

  if (!SD.exists("/pending.csv")) {
    File file = SD.open("/pending.csv", FILE_WRITE);
    if (file) {
      file.println("epoch_ms,date,time,event,current_weight,last_drink,total_drink");
      file.close();
      Serial.println("pending.csv created");
    }
  }
}

