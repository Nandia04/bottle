// =====================================================
// BLYNK SEND / RECEIVE
// =====================================================
void sendToBlynkIfChanged(bool forceSend = false) {
  if (WiFi.status() != WL_CONNECTED || !Blynk.connected()) return;

  String nextTime = getNextReminderString();
  float successRate = calculateSuccessRate();
  String sdStatus = sdReady ? "SD card OK" : "SD card алдаа";
  String systemStartTime = systemStartTimeStr;

  if (forceSend || fabs(currentWeight - prevSentWeight) > 1.0) {
    Blynk.virtualWrite(V0, currentWeight);
    prevSentWeight = currentWeight;
  }

  if (forceSend || fabs(lastDrink - prevSentLastDrink) > 0.1) {
    Blynk.virtualWrite(V1, lastDrink);
    prevSentLastDrink = lastDrink;
  }

  if (forceSend || fabs(totalDrink - prevSentTotalDrink) > 0.1) {
    Blynk.virtualWrite(V2, totalDrink);
    prevSentTotalDrink = totalDrink;
  }

  if (forceSend || fabs(dailyGoal - prevSentDailyGoal) > 0.1) {
    Blynk.virtualWrite(V3, dailyGoal);
    prevSentDailyGoal = dailyGoal;
  }

  int reminderEnabledState = reminderEnabled ? 1 : 0;
  if (forceSend || reminderEnabledState != prevSentReminderEnabled) {
    Blynk.virtualWrite(V4, reminderEnabledState);
    prevSentReminderEnabled = reminderEnabledState;
  }

  if (forceSend || completedDrinks != prevSentCompletedDrinks) {
    Blynk.virtualWrite(V5, completedDrinks);
    prevSentCompletedDrinks = completedDrinks;
  }

  if (forceSend || nextTime != prevSentNextTime) {
    Blynk.virtualWrite(V6, nextTime);
    prevSentNextTime = nextTime;
  }

  if (forceSend || waterStatus != prevSentWaterStatus) {
    Blynk.virtualWrite(V7, waterStatus);
    prevSentWaterStatus = waterStatus;
  }

  if (forceSend || reminderCount != prevSentReminderCount) {
    Blynk.virtualWrite(V8, reminderCount);
    prevSentReminderCount = reminderCount;
  }

  if (forceSend || fabs(successRate - prevSentSuccessRate) > 0.5) {
    Blynk.virtualWrite(V9, successRate);
    prevSentSuccessRate = successRate;
  }

  if (forceSend || fabs(userWeightKg - prevSentUserWeight) > 0.1) {
    Blynk.virtualWrite(V10, userWeightKg);
    prevSentUserWeight = userWeightKg;
  }

  if (forceSend || fabs(userHeightCm - prevSentUserHeight) > 0.1) {
    Blynk.virtualWrite(V11, userHeightCm);
    prevSentUserHeight = userHeightCm;
  }

  if (forceSend || sleepTimeStr != prevSentSleepTime) {
    Blynk.virtualWrite(V12, sleepTimeStr);
    prevSentSleepTime = sleepTimeStr;
  }

  if (forceSend || systemStartTime != prevSentSystemStartTime) {
    Blynk.virtualWrite(V14, systemStartTime);
    prevSentSystemStartTime = systemStartTime;
  }

  if (forceSend || sdStatus != prevSentSdStatus) {
    Blynk.virtualWrite(V15, sdStatus);
    prevSentSdStatus = sdStatus;
  }
}

BLYNK_CONNECTED() {
  Serial.println("BLYNK_CONNECTED");
  Blynk.syncVirtual(V4, V10, V11, V12);
  sendToBlynkIfChanged(true);
}

// V4 = Сануулагч ON/OFF
BLYNK_WRITE(V4) {
  reminderEnabled = param.asInt() == 1;
  saveUserSettings();

  if (!reminderEnabled) {
    reminderActive = false;
    clearPixel();
    buzzerOff();
    waterStatus = "Сануулагч унтарсан";
  } else {
    waterStatus = "Хэвийн";
  }

  sendToBlynkIfChanged(true);
}

// V10 = Биеийн жин. Үүнээс V3 Daily goal автоматаар бодогдоно.
BLYNK_WRITE(V10) {
  float v = param.asFloat();

  if (v >= 30.0 && v <= 150.0) {
    userWeightKg = v;
    calculateDailyGoal();
    saveUserSettings();

    Serial.print("Blynk weight updated: ");
    Serial.print(userWeightKg, 1);
    Serial.print(" kg, daily goal: ");
    Serial.print(dailyGoal, 0);
    Serial.println(" ml");

    sendToBlynkIfChanged(true);
  }
}

// V11 = Өндөр. Одоогоор өдөр тутмын зорилго жингээр бодогдоно.
// Өндрийг хэрэглэгчийн мэдээлэл болгож хадгална.
BLYNK_WRITE(V11) {
  float v = param.asFloat();

  if (v >= 50.0 && v <= 250.0) {
    userHeightCm = v;
    saveUserSettings();

    Serial.print("Blynk height updated: ");
    Serial.print(userHeightCm, 1);
    Serial.println(" cm");

    sendToBlynkIfChanged(true);
  }
}

// V12 = Унтах цаг. Жишээ: "23:00"
BLYNK_WRITE(V12) {
  sleepTimeStr = param.asString();

  if (sleepTimeStr.length() == 0) {
    sleepTimeStr = "23:00";
  }

  saveUserSettings();

  Serial.print("Blynk sleep time updated: ");
  Serial.println(sleepTimeStr);

  sendToBlynkIfChanged(true);
}

// =====================================================
// BLYNK HISTORY UPLOAD
// =====================================================
bool postHistoryArray(const String &pin, const String &jsonArray) {
  WiFiClientSecure client;
  client.setInsecure();

  HTTPClient http;
  String url = "https://blynk.cloud/external/api/batch/update?token=" + String(BLYNK_AUTH_TOKEN) + "&pin=" + pin;

  http.begin(client, url);
  http.addHeader("Content-Type", "application/json");

  int httpCode = http.POST(jsonArray);
  String response = http.getString();

  http.end();

  Serial.print("POST ");
  Serial.print(pin);
  Serial.print(" -> HTTP ");
  Serial.println(httpCode);

  if (httpCode >= 200 && httpCode < 300) {
    return true;
  }

  Serial.println(response);
  return false;
}

bool syncPendingToBlynk() {
  if (!sdReady) return false;
  if (WiFi.status() != WL_CONNECTED) return false;
  if (!Blynk.connected()) return false;

  File file = SD.open("/pending.csv", FILE_READ);
  if (!file) {
    Serial.println("No pending.csv to sync");
    return false;
  }

  String header = file.readStringUntil('\n');

  String jsonV0 = "[";
  String jsonV1 = "[";
  String jsonV2 = "[";

  const int maxBatch = 20;
  int count = 0;

  while (file.available() && count < maxBatch) {
    String line = file.readStringUntil('\n');
    line.trim();

    if (line.length() == 0) continue;

    int p1 = line.indexOf(',');
    int p2 = line.indexOf(',', p1 + 1);
    int p3 = line.indexOf(',', p2 + 1);
    int p4 = line.indexOf(',', p3 + 1);
    int p5 = line.indexOf(',', p4 + 1);
    int p6 = line.indexOf(',', p5 + 1);

    if (p1 < 0 || p2 < 0 || p3 < 0 || p4 < 0 || p5 < 0 || p6 < 0) continue;

    String epochMsStr       = line.substring(0, p1);
    String currentWeightStr = line.substring(p4 + 1, p5);
    String lastDrinkStr     = line.substring(p5 + 1, p6);
    String totalDrinkStr    = line.substring(p6 + 1);

    if (count > 0) {
      jsonV0 += ",";
      jsonV1 += ",";
      jsonV2 += ",";
    }

    jsonV0 += "[" + epochMsStr + "," + currentWeightStr + "]";
    jsonV1 += "[" + epochMsStr + "," + lastDrinkStr + "]";
    jsonV2 += "[" + epochMsStr + "," + totalDrinkStr + "]";

    count++;
  }

  file.close();

  if (count == 0) {
    Serial.println("No pending rows to sync");
    return false;
  }

  jsonV0 += "]";
  jsonV1 += "]";
  jsonV2 += "]";

  bool ok0 = postHistoryArray("v0", jsonV0);
  bool ok1 = postHistoryArray("v1", jsonV1);
  bool ok2 = postHistoryArray("v2", jsonV2);

  if (!(ok0 && ok1 && ok2)) {
    Serial.println("Sync failed, pending data kept");
    return false;
  }

  File inFile = SD.open("/pending.csv", FILE_READ);
  if (!inFile) return false;

  File outFile = SD.open("/temp.csv", FILE_WRITE);
  if (!outFile) {
    inFile.close();
    return false;
  }

  String firstLine = inFile.readStringUntil('\n');
  outFile.println(firstLine);

  int skipped = 0;

  while (inFile.available()) {
    String line = inFile.readStringUntil('\n');
    line.trim();

    if (line.length() == 0) continue;

    if (skipped < count) {
      skipped++;
      continue;
    }

    outFile.println(line);
  }

  inFile.close();
  outFile.close();

  SD.remove("/pending.csv");
  SD.rename("/temp.csv", "/pending.csv");

  Serial.print("Synced rows: ");
  Serial.println(count);

  return true;
}

void syncAllPendingToBlynk() {
  if (!sdReady) return;
  if (WiFi.status() != WL_CONNECTED) return;
  if (!Blynk.connected()) return;

  Serial.println("Syncing pending SD history to Blynk...");

  int rounds = 0;
  const int maxRounds = 200;

  while (rounds < maxRounds) {
    Blynk.run();

    bool ok = syncPendingToBlynk();
    if (!ok) break;

    rounds++;
    delay(300);
  }

  sendToBlynkIfChanged(true);

  Serial.print("Sync rounds done: ");
  Serial.println(rounds);
}

// =====================================================
// WIFI CONTROL
// =====================================================
void wifiOff() {
  // Wi-Fi-г кодоор унтраахгүй.
  Serial.println("wifiOff() skipped: WiFi kept ON");
}

bool connectWifi() {
  if (String(WIFI_SSID).length() == 0 || String(WIFI_SSID) == "YOUR_WIFI_NAME") {
    Serial.println("WiFi SSID not configured. Offline mode.");
    return false;
  }

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.setAutoReconnect(true);
  WiFi.persistent(false);

  if (WiFi.status() == WL_CONNECTED) return true;

  WiFi.begin(WIFI_SSID, WIFI_PASS);

  Serial.print("Connecting WiFi");

  unsigned long startAttempt = millis();

  while (WiFi.status() != WL_CONNECTED && millis() - startAttempt < wifiConnectTimeout) {
    delay(250);
    Serial.print(".");
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("WiFi connected");
    Serial.println(WiFi.localIP());
    return true;
  }

  Serial.println("WiFi connect failed. System continues offline.");
  return false;
}

bool connectBlynk() {
  if (WiFi.status() != WL_CONNECTED) return false;

  Blynk.config(BLYNK_AUTH_TOKEN);

  unsigned long startAttempt = millis();

  while (!Blynk.connected() && millis() - startAttempt < blynkConnectTimeout) {
    Blynk.connect(500);
    Blynk.run();
    delay(100);
  }

  if (Blynk.connected()) {
    Serial.println("Blynk connected");
    return true;
  }

  Serial.println("Blynk connect failed. System continues offline.");
  return false;
}

void maintainBlynkConnection() {
  static unsigned long lastReconnectTry = 0;
  const unsigned long reconnectInterval = 5000UL;

  if (millis() - lastReconnectTry < reconnectInterval) return;

  lastReconnectTry = millis();

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi disconnected. Reconnecting...");
    connectWifi();
    return;
  }

  if (!Blynk.connected()) {
    Serial.println("Blynk disconnected. Reconnecting...");
    connectBlynk();
    return;
  }

  Blynk.run();
}

void syncNow() {
  Serial.println("SYNC START");

  bool wifiOK = connectWifi();

  if (!wifiOK) {
    syncFailedLed();
    waterStatus = "Offline - SD хадгалж байна";
    return;
  }

  bool blynkOK = connectBlynk();

  if (!blynkOK) {
    syncFailedLed();
    waterStatus = "Blynk холбогдоогүй";
    return;
  }

  sendToBlynkIfChanged(true);
  syncAllPendingToBlynk();

  syncSuccessLed();
  waterStatus = "Хэвийн";

  Serial.println("SYNC DONE");
}

void tryAutoSync() {
  maintainBlynkConnection();

  if (Blynk.connected()) {
    Blynk.run();
    sendToBlynkIfChanged();
  }

  if (millis() - lastSyncAttempt < autoSyncInterval) return;

  lastSyncAttempt = millis();
  syncNow();
}

