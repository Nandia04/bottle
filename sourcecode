// =====================================================
// STRING HELPERS
// =====================================================
String twoDigit(int v) {
  if (v < 10) return "0" + String(v);
  return String(v);
}

String getDateString(DateTime now) {
  return String(now.year()) + "-" + twoDigit(now.month()) + "-" + twoDigit(now.day());
}

String getTimeString(DateTime now) {
  return twoDigit(now.hour()) + ":" + twoDigit(now.minute()) + ":" + twoDigit(now.second());
}

uint64_t getEpochMillis(DateTime now) {
  return (uint64_t)now.unixtime() * 1000ULL;
}

